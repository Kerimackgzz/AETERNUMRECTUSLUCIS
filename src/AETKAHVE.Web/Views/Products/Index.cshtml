@model ProductListViewModel
@{
    ViewData["Title"] = "Ürünler";
}
<header class="page-banner page-banner--shop">
    <div class="container page-banner__content">
        <p class="text-eyebrow">Koleksiyon</p>
        <h1>Kahve Seçkimiz</h1>
    </div>
</header>
<div class="container">
    <partial name="_ProductListing" model="Model" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
}

@section PageScripts {
    <script type="module" src="~/js/pages/shop-filters.js" asp-append-version="true"></script>
    <script type="module" src="~/js/pages/price-range.js" asp-append-version="true"></script>
}
