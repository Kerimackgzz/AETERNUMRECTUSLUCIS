@model CustomerEmailChangeConfirmViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "E-posta değişikliğini doğrula";
}
<section class="account-card account-card--center surface surface--padded"
         data-email-change-state="@(Model.CanConfirm ? "ready" : "invalid")">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <p class="field-validation-error" role="alert">@Model.StatusMessage</p>
    }
    @if (Model.CanConfirm)
    {
        <span class="status-badge account-confirmation__status" data-status-kind="success">Bağlantı doğrulandı</span>
        <h1 class="account-card__title">E-posta değişikliğini tamamlayın</h1>
        <p class="account-card__subtitle text-muted">
            <strong>@Model.MaskedEmail</strong> adresini hesabınıza bağlamak üzeresiniz. Onaydan sonra tüm oturumlarınız kapatılır.
        </p>
        <form class="account-form account-confirmation__form"
              asp-action="ConfirmEmailChangePost"
              asp-antiforgery="true"
              method="post">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="NewEmail" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <button type="submit" class="btn btn--primary btn--block">E-posta adresini değiştir</button>
        </form>
        <p class="account-confirmation__note text-sm text-muted">Parolanız değişmez; yeni e-posta adresinizle yeniden giriş yapabilirsiniz.</p>
    }
    else
    {
        <span class="status-badge account-confirmation__status" data-status-kind="error">Bağlantı kullanılamıyor</span>
        <h1 class="account-card__title">Bağlantı geçersiz veya süresi dolmuş</h1>
        <p class="account-card__subtitle text-muted">Bu bağlantı daha önce kullanılmış, değiştirilmiş veya süresi dolmuş olabilir.</p>
        <a asp-action="Login" class="btn btn--primary btn--block">Girişe dön</a>
    }
</section>
