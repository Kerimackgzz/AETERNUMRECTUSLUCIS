@model RegisterViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Kayıt";
}
<h1>Kayıt</h1>
<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <label asp-for="FirstName">Ad</label><input asp-for="FirstName" /><span asp-validation-for="FirstName"></span>
    <label asp-for="LastName">Soyad</label><input asp-for="LastName" /><span asp-validation-for="LastName"></span>
    <label asp-for="Email">E-posta</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span>
    <label asp-for="Password">Parola</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span>
    <label asp-for="ConfirmPassword">Parola tekrarı</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span>
    <label><input asp-for="AcceptPrivacyTerms" /> Gizlilik koşullarını kabul ediyorum</label>
    <span asp-validation-for="AcceptPrivacyTerms"></span>
    <button type="submit">Kayıt Ol</button>
</form>

