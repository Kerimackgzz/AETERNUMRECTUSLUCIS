@model RegisterViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Kayıt";
}
<div class="account-card surface surface--padded">
    <h1 class="account-card__title">Hesap oluştur</h1>
    <p class="account-card__subtitle text-muted">
        Bilgilerinizi gönderin; üyeliğinizi güvenle tamamlamanız için e-posta adresinize tek kullanımlık bir bağlantı iletelim.
    </p>
    <form class="account-form" asp-action="Register" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" role="alert" class="text-sm"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="field">
            <label asp-for="FirstName">Ad</label>
            <input asp-for="FirstName" autocomplete="given-name" placeholder="Adınız" />
            <span asp-validation-for="FirstName" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label asp-for="LastName">Soyad</label>
            <input asp-for="LastName" autocomplete="family-name" placeholder="Soyadınız" />
            <span asp-validation-for="LastName" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label asp-for="Email">E-posta</label>
            <input asp-for="Email" autocomplete="email" placeholder="ornek@eposta.com" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password">Parola</label>
            <div class="password-input" data-password-field>
                <input asp-for="Password" autocomplete="new-password" placeholder="Güçlü bir parola oluşturun" aria-describedby="password-requirements" data-password-input />
                <partial name="_PasswordVisibilityButton" />
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">Parola tekrarı</label>
            <div class="password-input" data-password-field>
                <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Parolanızı tekrar girin" data-password-input />
                <partial name="_PasswordVisibilityButton" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
        <partial name="_PasswordRequirements" />
        <div class="field">
            <label><input asp-for="AcceptPrivacyTerms" /> Gizlilik koşullarını kabul ediyorum</label>
            <span asp-validation-for="AcceptPrivacyTerms" class="field-validation-error"></span>
        </div>
        <button type="submit" class="btn btn--primary btn--block">Doğrulama bağlantısı gönder</button>
    </form>
    <p class="text-sm text-muted">
        Bağlantıyı açmak hesabınızı otomatik olarak oluşturmaz; açılan ekranda “Üyeliği tamamla” onayını vermeniz gerekir.
    </p>
    @if (ViewData["ExistingAccount"] as bool? == true)
    {
        <aside class="account-existing" aria-label="Mevcut hesap seçenekleri">
            <p>Bu hesap için yeni doğrulama e-postası gönderilmedi. Hesabınıza uygun işlemi seçin.</p>
            <div class="account-existing__links">
                <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Müşteri girişi</a>
                <a asp-action="ForgotPassword">Parolayı sıfırla</a>
            </div>
        </aside>
    }
    <div class="account-form__footer">
        <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Zaten hesabınız var mı? Giriş yapın</a>
        <a asp-action="ResendConfirmation" asp-route-returnUrl="@Model.ReturnUrl">Bağlantı gelmedi mi?</a>
    </div>
</div>
