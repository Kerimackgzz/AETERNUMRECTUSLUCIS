@model ForgotPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Şifremi Unuttum";
}
<div class="account-card surface surface--padded">
    <h1 class="account-card__title">Şifremi unuttum</h1>
    <p class="account-card__subtitle text-muted">E-posta adresinize sıfırlama bağlantısı gönderelim.</p>
    <form class="account-form" asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" role="alert" class="text-sm"></div>
        <div class="field">
            <label asp-for="Email">E-posta</label>
            <input asp-for="Email" autocomplete="email" placeholder="ornek@eposta.com" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <button type="submit" class="btn btn--primary btn--block">Bağlantı Gönder</button>
    </form>
    <div class="account-form__footer">
        <a asp-action="Login">Girişe dön</a>
    </div>
</div>
