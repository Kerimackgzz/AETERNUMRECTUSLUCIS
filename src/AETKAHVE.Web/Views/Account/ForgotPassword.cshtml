@model ForgotPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Şifremi Unuttum";
}
<h1>Şifremi Unuttum</h1>
<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <label asp-for="Email">E-posta</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span>
    <button type="submit">Bağlantı Gönder</button>
</form>

