@model ResetPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Parola Sıfırla";
}
<div class="account-card surface surface--padded">
    <h1 class="account-card__title">Parolayı sıfırla</h1>
    <p class="account-card__subtitle text-muted">Yeni parolanızı belirleyin.</p>
    <form class="account-form" asp-action="ResetPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" role="alert" class="text-sm"></div>
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <div class="field">
            <label asp-for="Password">Yeni parola</label>
            <div class="password-input" data-password-field>
                <input asp-for="Password" autocomplete="new-password" placeholder="Yeni güçlü parolanız" aria-describedby="password-requirements" data-password-input />
                <partial name="_PasswordVisibilityButton" />
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">Yeni parola tekrarı</label>
            <div class="password-input" data-password-field>
                <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Yeni parolanızı tekrar girin" data-password-input />
                <partial name="_PasswordVisibilityButton" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
        <partial name="_PasswordRequirements" />
        <button type="submit" class="btn btn--primary btn--block">Parolayı Değiştir</button>
    </form>
</div>
