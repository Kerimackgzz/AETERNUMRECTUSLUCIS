@model ResetPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Parola Sıfırla";
}
<h1>Parola Sıfırla</h1>
<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <input asp-for="Email" type="hidden" />
    <input asp-for="Token" type="hidden" />
    <label asp-for="Password">Yeni parola</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span>
    <label asp-for="ConfirmPassword">Yeni parola tekrarı</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span>
    <button type="submit">Parolayı Değiştir</button>
</form>

