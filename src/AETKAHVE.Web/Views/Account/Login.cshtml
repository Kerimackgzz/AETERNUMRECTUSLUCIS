@model LoginViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Giriş";
}
<div class="account-card surface surface--padded">
    <h1 class="account-card__title">Giriş</h1>
    <p class="account-card__subtitle text-muted">Hesabınıza erişmek için bilgilerinizi girin.</p>
    <form class="account-form" asp-action="Login" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" role="alert" class="text-sm"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="field">
            <label asp-for="Email">E-posta</label>
            <input asp-for="Email" autocomplete="email" placeholder="ornek@eposta.com" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password">Parola</label>
            <div class="password-input" data-password-field>
                <input asp-for="Password" autocomplete="current-password" placeholder="Parolanızı girin" data-password-input />
                <partial name="_PasswordVisibilityButton" />
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="account-form__options">
            <label class="account-form__remember">
                <input asp-for="RememberMe" />
                <span>Beni hatırla</span>
            </label>
            <a asp-action="ForgotPassword">Şifremi unuttum?</a>
        </div>
        <button type="submit" class="btn btn--primary btn--block">Giriş Yap</button>
    </form>
    <nav class="account-auth-links" aria-label="Hesap işlemleri">
        <p>Henüz bir hesabınız yok mu?</p>
        <a class="btn btn--outline btn--block" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Yeni hesap oluştur</a>
        <a class="account-auth-links__recovery" asp-action="ResendConfirmation" asp-route-returnUrl="@Model.ReturnUrl">
            Doğrulama e-postası gelmedi mi? <span>Yeniden gönder</span>
        </a>
    </nav>
</div>
