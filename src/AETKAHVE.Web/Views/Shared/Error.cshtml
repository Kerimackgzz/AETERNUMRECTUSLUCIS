@model ErrorViewModel
@{
    ViewData["Title"] = "Bir Hata Oluştu";
}
<div class="container section">
    <div class="surface surface--padded account-card">
        <h1 class="account-card__title">Bir şeyler ters gitti</h1>
        <p class="text-muted">İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen tekrar deneyin.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-sm text-muted">
                <strong>İstek Kimliği:</strong> <code>@Model.RequestId</code>
            </p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn--outline">Ana sayfaya dön</a>
    </div>
</div>
