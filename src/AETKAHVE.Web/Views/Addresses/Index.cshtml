@model AddressListViewModel
@{
    ViewData["Title"] = "Adreslerim";
    Layout = "_CustomerAccountLayout";
}
<div class="account-card checkout-card surface surface--padded" data-addresses-page>
    <h1 class="account-card__title">Adreslerim</h1>

    @if (Model.Addresses.Count > 0)
    {
        <div class="address-picker mb-4">
            @foreach (var address in Model.Addresses)
            {
                <div class="address-card">
                    <span class="address-card__title">@address.Title</span>
                    <p class="address-card__body">
                        @address.FirstName @address.LastName · @address.PhoneNumber<br />
                        @address.AddressLine, @address.District/@address.City<br />
                        @(address.IsDefaultShipping ? "Varsayılan teslimat · " : "")@(address.IsDefaultBilling ? "Varsayılan fatura" : "")
                    </p>
                    <button type="button" class="btn btn--ghost btn--sm" data-address-delete="/account/addresses/@address.Id/delete">Sil</button>
                </div>
            }
        </div>
    }

    <h2 class="text-lg mb-4">Yeni adres ekle</h2>
    <form class="account-form address-form" data-address-form novalidate>
        <div class="field field--full">
            <label for="addr-title">Adres başlığı</label>
            <input id="addr-title" name="Title" required maxlength="80" placeholder="Ev, İş, vb." />
        </div>
        <div class="field">
            <label for="addr-firstname">Ad</label>
            <input id="addr-firstname" name="FirstName" required maxlength="100" placeholder="Ahmet" />
        </div>
        <div class="field">
            <label for="addr-lastname">Soyad</label>
            <input id="addr-lastname" name="LastName" required maxlength="100" placeholder="Yılmaz" />
        </div>
        <div class="field">
            <label for="addr-phone">Telefon</label>
            <input id="addr-phone" name="PhoneNumber" required maxlength="30" placeholder="0555 555 55 55" />
        </div>
        <div class="field">
            <label for="addr-country">Ülke</label>
            <input id="addr-country" name="Country" required maxlength="100" value="Türkiye" readonly />
        </div>
        <div class="field">
            <label for="addr-city">İl</label>
            <select id="addr-city" name="City" required data-province-select>
                <option value="">İl seçin</option>
            </select>
        </div>
        <div class="field">
            <label for="addr-district">İlçe</label>
            <select id="addr-district" name="District" required disabled data-district-select>
                <option value="">Önce il seçin</option>
            </select>
        </div>
        <div class="field">
            <label for="addr-neighborhood">Mahalle</label>
            <input id="addr-neighborhood" name="Neighborhood" maxlength="150" placeholder="Caferağa Mahallesi" />
        </div>
        <div class="field">
            <label for="addr-postal">Posta kodu</label>
            <input id="addr-postal" name="PostalCode" maxlength="20" placeholder="34710" />
        </div>
        <div class="field field--full">
            <label for="addr-line">Açık adres</label>
            <textarea id="addr-line" name="AddressLine" class="checkout-note" required maxlength="1000" rows="3" placeholder="Sokak, cadde, bina no, daire no"></textarea>
        </div>
        <div class="field field--full">
            <label><input type="checkbox" name="isDefaultShipping" /> Varsayılan teslimat adresi</label>
        </div>
        <div class="field field--full">
            <label><input type="checkbox" name="isDefaultBilling" /> Varsayılan fatura adresi</label>
        </div>
        <button type="submit" class="btn btn--primary btn--block field--full">Adresi Kaydet</button>
    </form>
</div>

@section PageScripts {
    <script type="module" src="~/js/pages/addresses.js" asp-append-version="true"></script>
}
