@using System.Globalization
@using AETKAHVE.Domain.Commerce
@model AdminCampaignListViewModel
@{
    ViewData["Title"] = "Kampanya Yönetimi";
    var currency = new CultureInfo("tr-TR");
}
<h1 class="admin-dashboard__title">Kampanya Yönetimi</h1>
<div data-admin-campaigns-page>
    <div class="surface surface--padded mb-4">
        <h2 class="text-lg mb-4">Yeni kampanya</h2>
        <p class="text-muted text-sm mb-4">Ürün/kategori hedefleme boş bırakılırsa kampanya tüm katalogda geçerli olur. ID'ler <a asp-area="Admin" asp-controller="Catalog" asp-action="Index">Katalog Yönetimi</a>'nden kopyalanabilir.</p>
        <form data-campaign-form class="grid-auto">
            <input type="text" name="name" placeholder="Kampanya adı" required maxlength="150" />
            <select name="discountType">
                <option value="@DiscountType.Percentage">Yüzde</option>
                <option value="@DiscountType.FixedAmount">Sabit Tutar</option>
                <option value="@DiscountType.FreeShipping">Ücretsiz Kargo</option>
            </select>
            <input type="number" name="discountValue" placeholder="İndirim değeri" step="0.01" min="0" required />
            <input type="number" name="minimumCartAmount" placeholder="Min. sepet tutarı (opsiyonel)" step="0.01" min="0" />
            <input type="number" name="maximumDiscountAmount" placeholder="Maks. indirim (opsiyonel)" step="0.01" min="0" />
            <label>Başlangıç <input type="datetime-local" name="startDate" required /></label>
            <label>Bitiş <input type="datetime-local" name="endDate" required /></label>
            <textarea name="productIds" placeholder="Hedef ürün ID'leri (virgül/yeni satırla ayrılmış, opsiyonel)" class="checkout-note" rows="2"></textarea>
            <textarea name="categoryIds" placeholder="Hedef kategori ID'leri (virgül/yeni satırla ayrılmış, opsiyonel)" class="checkout-note" rows="2"></textarea>
            <label class="cluster"><input type="checkbox" name="canCombine" /> Diğer indirimlerle birleştirilebilir</label>
            <button type="submit" class="btn btn--primary">Kaydet</button>
        </form>
    </div>

    @if (Model.Campaigns.Items.Count == 0)
    {
        <div class="surface empty-state">
            <p class="empty-state__title">Kampanya yok</p>
        </div>
    }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Kampanya yönetimi tablosu">
        <table>
            <thead><tr><th>Ad</th><th>Tip</th><th>Değer</th><th>Aktif</th><th>Bitiş</th></tr></thead>
            <tbody>
                @foreach (var campaign in Model.Campaigns.Items)
                {
                    <tr>
                        <td>@campaign.Name</td>
                        <td>@campaign.DiscountType</td>
                        <td>@campaign.DiscountValue.ToString("N2", currency)</td>
                        <td>
                            <button type="button" class="status-badge" data-status-kind="@(campaign.IsActive ? "success" : "error")"
                                    data-toggle-campaign-active="@campaign.Id" data-active="@campaign.IsActive.ToString().ToLowerInvariant()"
                                    aria-label="@(campaign.IsActive ? "Kampanyayı pasif et" : "Kampanyayı aktif et")">
                                @(campaign.IsActive ? "Aktif" : "Pasif")
                            </button>
                        </td>
                        <td>@campaign.EndDateUtc.ToLocalTime().ToString("d MMM yyyy", currency)</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <partial name="_Pagination" model="(Model.Campaigns.Page, Model.Campaigns.TotalPages)" />
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
}

@section PageScripts {
    <script type="module" src="~/js/admin/campaigns.js" asp-append-version="true"></script>
}
