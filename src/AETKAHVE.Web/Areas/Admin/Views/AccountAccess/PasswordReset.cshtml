@model AdminAccountPasswordTokenViewModel
@{
    Layout = "_ManagementAuthLayout";
    ViewData["Title"] = "Admin Parolasını Sıfırla";
}

<div class="account-card surface surface--padded">
    <h1 class="account-card__title">Admin parolasını sıfırla</h1>
    @if (!Model.CanContinue)
    {
        <p class="account-card__subtitle text-muted">Parola sıfırlama bağlantısı geçersiz, kullanılmış veya süresi dolmuş.</p>
        <a class="btn btn--outline btn--block" href="/admin/login">Admin girişine dön</a>
    }
    else
    {
        <p class="account-card__subtitle text-muted">@Model.MaskedEmail için yeni parolanızı belirleyin.</p>
        <form class="account-form" action="/admin/password-reset" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" role="alert" class="field-validation-error"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="field">
                <label asp-for="Password"></label>
                <div class="password-input" data-password-field>
                    <input asp-for="Password" autocomplete="new-password" aria-describedby="password-requirements" data-password-input />
                    <partial name="_PasswordVisibilityButton" />
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <div class="password-input" data-password-field>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" data-password-input />
                    <partial name="_PasswordVisibilityButton" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <partial name="_PasswordRequirements" />
            <button class="btn btn--primary btn--block" type="submit">Parolayı değiştir</button>
        </form>
    }
</div>
