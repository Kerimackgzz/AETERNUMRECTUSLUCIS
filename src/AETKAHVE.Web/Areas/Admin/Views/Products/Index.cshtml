@using System.Globalization
@using AETKAHVE.Application.Commerce
@model PagedResult<AdminProductSummary>
@{
    ViewData["Title"] = "Ürün Yönetimi";
    var currency = new CultureInfo("tr-TR");
}
<h1 class="admin-dashboard__title">Ürün Yönetimi</h1>
<div data-admin-products-page>
    <details class="surface surface--padded mb-4" data-product-create-panel>
        <summary class="text-lg">Yeni ürün ekle</summary>
        <p class="text-muted text-sm mb-4">Koleksiyon/marka/kahve tipi vb. ID'lerini <a asp-area="Admin" asp-controller="Catalog" asp-action="Index" target="_blank" rel="noopener">Katalog Yönetimi</a> sayfasındaki kayıtlara tıklayarak kopyalayabilirsiniz. Koleksiyon zorunludur, diğerleri opsiyoneldir.</p>
        <form data-product-form class="grid-auto">
            <input type="text" name="name" placeholder="Ürün adı" required maxlength="200" />
            <input type="text" name="sku" placeholder="SKU" required maxlength="80" />
            <input type="text" name="shortDescription" placeholder="Kısa açıklama" required maxlength="500" />
            <textarea name="description" placeholder="Uzun açıklama" required maxlength="8000" rows="3" class="checkout-note"></textarea>
            <input type="number" name="basePrice" placeholder="Fiyat" step="0.01" min="0" required />
            <input type="number" name="discountedPrice" placeholder="İndirimli fiyat (opsiyonel)" step="0.01" min="0" />
            <input type="number" name="taxRate" placeholder="Vergi oranı (%)" step="0.01" min="0" value="10" required />
            <input type="number" name="stockQuantity" placeholder="Stok adedi" min="0" required />
            <input type="number" name="criticalStockLevel" placeholder="Kritik stok seviyesi" min="0" value="5" />
            <input type="text" name="categoryId" placeholder="Koleksiyon ID (zorunlu)" required class="input-wide" />
            <input type="text" name="brandId" placeholder="Marka ID (opsiyonel)" class="input-wide" />
            <input type="text" name="coffeeTypeId" placeholder="Kahve Tipi ID (opsiyonel)" class="input-wide" />
            <input type="text" name="beanTypeId" placeholder="Çekirdek Tipi ID (opsiyonel)" class="input-wide" />
            <input type="text" name="roastLevelId" placeholder="Kavurma ID (opsiyonel)" class="input-wide" />
            <input type="text" name="originId" placeholder="Menşei ID (opsiyonel)" class="input-wide" />
            <label class="cluster"><input type="checkbox" name="isActive" checked /> Aktif</label>
            <label class="cluster"><input type="checkbox" name="isFeatured" /> Öne çıkan</label>
            <button type="submit" class="btn btn--primary">Ürünü Kaydet</button>
            <button type="button" class="btn btn--secondary" data-product-draft-clear>Taslağı temizle</button>
        </form>
    </details>

    @if (Model.Items.Count == 0)
    {
        <div class="surface empty-state">
            <p class="empty-state__title">Kayıtlı ürün yok</p>
        </div>
    }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Ürün yönetimi tablosu">
        <table>
            <thead><tr><th>Ürün</th><th>Koleksiyon</th><th>Fiyat</th><th>Stok</th><th>Durum</th><th>Stok İşlemi</th></tr></thead>
            <tbody>
                @foreach (var product in Model.Items)
                {
                    <tr data-product-row data-product-id="@product.Id">
                        <td>@product.Name<br /><span class="text-sm text-muted">@product.Slug</span><br /><span class="text-sm text-muted">@product.Id</span></td>
                        <td>@product.CategoryName</td>
                        <td>@product.DisplayPrice.ToString("N2", currency) ₺</td>
                        <td>
                            <span data-stock-quantity>@product.StockQuantity</span> adet
                            <br />
                            <span class="status-badge" data-status-kind="@(product.StockQuantity > 0 ? "success" : "error")">@(product.StockQuantity > 0 ? "Stokta" : "Tükendi")</span>
                        </td>
                        <td>
                            <button type="button" class="status-badge" data-status-kind="@(product.IsActive ? "success" : "error")"
                                    data-toggle-product-active="@product.Id" data-active="@product.IsActive.ToString().ToLowerInvariant()"
                                    aria-label="@(product.IsActive ? "Ürünü kaldır (pasif et)" : "Ürünü tekrar yayına al")">
                                @(product.IsActive ? "Aktif" : "Kaldırıldı")
                            </button>
                        </td>
                        <td>
                            <div class="stock-actions" role="group" aria-label="@product.Name stok işlemleri">
                                <button type="button"
                                        class="stock-action stock-action--decrease"
                                        data-stock-adjust="-1"
                                        aria-label="@product.Name stok miktarını 1 azalt">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M5 12h14" />
                                    </svg>
                                    <span>1 azalt</span>
                                </button>
                                <button type="button"
                                        class="stock-action stock-action--increase"
                                        data-stock-adjust="1"
                                        aria-label="@product.Name stok miktarını 1 artır">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M12 5v14M5 12h14" />
                                    </svg>
                                    <span>1 artır</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <partial name="_Pagination" model="(Model.Page, Model.TotalPages)" />
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/products.css" asp-append-version="true" />
}

@section PageScripts {
    <script type="module" src="~/js/admin/products.js" asp-append-version="true"></script>
}
