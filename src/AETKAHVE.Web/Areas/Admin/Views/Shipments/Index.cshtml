@using System.Globalization
@using AETKAHVE.Domain.Commerce
@model AdminShipmentListViewModel
@{
    ViewData["Title"] = "Kargo Yönetimi";
    var currency = new CultureInfo("tr-TR");
}
<h1 class="admin-dashboard__title">Kargo Yönetimi</h1>
<div data-admin-shipments-page>
    @if (Model.Shipments.Items.Count == 0)
    {
        <div class="surface empty-state">
            <p class="empty-state__title">Kargo yok</p>
        </div>
    }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Kargo yönetimi tablosu">
        <table>
            <thead><tr><th>Sipariş No</th><th>Durum</th><th>Takip No</th><th>Güncelleme</th><th></th></tr></thead>
            <tbody>
                @foreach (var shipment in Model.Shipments.Items)
                {
                    var isDraft = shipment.Status == ShipmentStatus.Pending && string.IsNullOrWhiteSpace(shipment.TrackingNumber);
                    var canTrack = !string.IsNullOrWhiteSpace(shipment.TrackingNumber) &&
                        shipment.Status is ShipmentStatus.Created or ShipmentStatus.Shipped or ShipmentStatus.OutForDelivery;
                    var canCancel = !string.IsNullOrWhiteSpace(shipment.TrackingNumber) &&
                        shipment.Status is ShipmentStatus.Pending or ShipmentStatus.Created;
                    var shipmentStatusInfo = CommerceStatusDisplay.ShipmentStatusInfo(shipment.Status);
                    <tr data-shipment-row data-order-id="@shipment.OrderId">
                        <td>@shipment.OrderNumber</td>
                        <td><span class="status-badge" data-status-kind="@shipmentStatusInfo.Kind">@shipmentStatusInfo.Label</span></td>
                        <td>@(shipment.TrackingNumber ?? "—")</td>
                        <td>@shipment.UpdatedAtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm", currency)</td>
                        <td class="cluster">
                            @if (isDraft)
                            {
                                <input type="text" data-shipment-note placeholder="Not (opsiyonel)" aria-label="Kargo notu" />
                                <button type="button" class="btn btn--primary btn--sm" data-shipment-create>Kargo oluştur</button>
                            }
                            else
                            {
                                @if (canTrack)
                                {
                                    <button type="button" class="btn btn--ghost btn--sm" data-shipment-track>Takip et</button>
                                }
                                @if (canCancel)
                                {
                                    <button type="button" class="btn btn--ghost btn--sm" data-shipment-cancel>İptal</button>
                                }
                                @if (!canTrack && !canCancel)
                                {
                                    <span class="text-muted">Tamamlandı</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <partial name="_Pagination" model="(Model.Shipments.Page, Model.Shipments.TotalPages)" />
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
}

@section PageScripts {
    <script type="module" src="~/js/admin/shipments.js" asp-append-version="true"></script>
}
