@using System.Globalization
@model AdminShipmentListViewModel
@{
    ViewData["Title"] = "Kargo Yönetimi";
    var currency = new CultureInfo("tr-TR");
}
<h1 class="admin-dashboard__title">Kargo Yönetimi</h1>
<div data-admin-shipments-page>
    <div class="surface surface--padded mb-4">
        <h2 class="text-lg mb-4">Yeni kargo oluştur</h2>
        <form data-shipment-create-form class="cluster">
            <input type="text" name="orderId" placeholder="Sipariş ID (GUID)" required class="input-wide" />
            <input type="text" name="note" placeholder="Not (opsiyonel)" />
            <button type="submit" class="btn btn--primary btn--sm">Oluştur</button>
        </form>
    </div>

    @if (Model.Shipments.Items.Count == 0)
    {
        <div class="surface empty-state">
            <p class="empty-state__title">Kargo yok</p>
        </div>
    }
    else
    {
        <table>
            <thead><tr><th>Sipariş No</th><th>Durum</th><th>Takip No</th><th>Güncelleme</th><th></th></tr></thead>
            <tbody>
                @foreach (var shipment in Model.Shipments.Items)
                {
                    <tr>
                        <td>@shipment.OrderNumber</td>
                        <td>@shipment.Status</td>
                        <td>@(shipment.TrackingNumber ?? "—")</td>
                        <td>@shipment.UpdatedAtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm", currency)</td>
                        <td class="cluster">
                            <button type="button" class="btn btn--ghost btn--sm" data-shipment-track data-order-id="@shipment.OrderId">Takip et</button>
                            <button type="button" class="btn btn--ghost btn--sm" data-shipment-cancel data-order-id="@shipment.OrderId">İptal</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <partial name="_Pagination" model="(Model.Shipments.Page, Model.Shipments.TotalPages)" />
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
}

@section PageScripts {
    <script type="module" src="~/js/admin/shipments.js" asp-append-version="true"></script>
}
