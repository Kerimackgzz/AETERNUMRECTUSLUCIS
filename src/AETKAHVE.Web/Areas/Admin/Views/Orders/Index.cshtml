@using System.Globalization
@using AETKAHVE.Application.Commerce
@using AETKAHVE.Domain.Commerce
@model PagedResult<OrderSummary>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
    var currency = new CultureInfo("tr-TR");
}
<h1 class="admin-dashboard__title">Sipariş Yönetimi</h1>
<div data-admin-orders-page>
    @if (Model.Items.Count == 0)
    {
        <div class="surface empty-state">
            <p class="empty-state__title">Sipariş yok</p>
        </div>
    }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Sipariş yönetimi tablosu">
        <table>
            <thead><tr><th>Sipariş No</th><th>Tarih</th><th>Durum</th><th>Tutar</th><th></th><th>Durum Değiştir</th></tr></thead>
            <tbody>
                @foreach (var order in Model.Items)
                {
                    // İade Talep Edildi yalnızca müşterinin gerçek bir iade talebi göndermesiyle otomatik oluşur;
                    // burada elle seçilebilir bir seçenek olarak sunulmaz (bkz. ChangeOrderStatusAsync koruması).
                    var allowedNext = OrderStatusRules.GetAllowedNext(order.Status).Where(s => s != OrderStatus.ReturnRequested).ToList();
                    var statusInfo = CommerceStatusDisplay.OrderStatusInfo(order.Status);
                    <tr>
                        <td>@order.OrderNumber<br /><span class="text-sm text-muted">@order.Id</span></td>
                        <td>@order.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm", currency)</td>
                        <td><span class="status-badge" data-status-kind="@statusInfo.Kind">@statusInfo.Label</span></td>
                        <td>@order.GrandTotal.ToString("N2", currency) ₺</td>
                        <td><a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@order.Id" class="btn btn--ghost btn--sm">Detay</a></td>
                        <td>
                            @if (allowedNext.Count == 0)
                            {
                                <span class="text-muted text-sm">Son durum</span>
                            }
                            else
                            {
                                <form data-order-status-form data-order-id="@order.Id" class="cluster">
                                    <select name="status">
                                        @foreach (var status in allowedNext)
                                        {
                                            <option value="@status">@CommerceStatusDisplay.OrderStatusInfo(status).Label</option>
                                        }
                                    </select>
                                    <input type="text" name="description" placeholder="Not (opsiyonel)" class="text-sm" />
                                    <button type="submit" class="btn btn--outline btn--sm">Uygula</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <partial name="_Pagination" model="(Model.Page, Model.TotalPages)" />
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
}

@section PageScripts {
    <script type="module" src="~/js/admin/orders.js" asp-append-version="true"></script>
}
