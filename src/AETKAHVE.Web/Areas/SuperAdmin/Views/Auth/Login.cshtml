@model SuperAdminLoginViewModel
@{
    ViewData["Title"] = "SuperAdmin Girişi";
    Layout = "_ManagementAuthLayout";
}
<div class="account-card surface surface--padded">
    <h1 class="account-card__title">SuperAdmin Girişi</h1>
    <p class="account-card__subtitle text-muted">Yalnızca yetkili üst yönetim hesapları içindir.</p>
    <form class="account-form" action="/superadmin/login" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" role="alert" class="text-sm"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="field">
            <label asp-for="Email">E-posta</label>
            <input asp-for="Email" type="email" autocomplete="username" placeholder="Üst yönetim e-posta adresi" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password">Parola</label>
            <div class="password-input" data-password-field>
                <input asp-for="Password" type="password" autocomplete="current-password" placeholder="SuperAdmin parolanızı girin" data-password-input />
                <partial name="_PasswordVisibilityButton" />
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="field">
            <label><input asp-for="RememberMe" /> Beni hatırla</label>
        </div>
        <button type="submit" class="btn btn--primary btn--block">Giriş Yap</button>
    </form>
</div>
