{
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=AETKAHVE;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "DataProtection": {
    "ApplicationName": "AETKAHVE",
    "KeyRingPath": "App_Data/data-protection-keys"
  },
  "Security": {
    "AdminIdleTimeoutMinutes": 15,
    "SuperAdminIdleTimeoutMinutes": 10,
    "CustomerRememberMeDays": 30,
    "AdminRememberMeHours": 12,
    "SuperAdminRememberMeHours": 4,
    "IdleWarningSeconds": 60,
    "AdminRoute": "admin",
    "SuperAdminRoute": "superadmin",
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "CookieSecurePolicy": "SameAsRequest",
    "CookieSameSiteMode": "Lax"
  },
  "IdentitySeed": {
    "Enabled": false
  },
  "Commerce": {
    "Currency": "TRY",
    "GuestCartLifetimeDays": 30,
    "MaximumCartItemQuantity": 20,
    "ShippingFee": 0,
    "FreeShippingThreshold": 0,
    "ReturnWindowDays": 14,
    "SeedDevelopmentData": true
  },
  "Payment": { "Provider": "Mock" },
  "Shipping": { "Provider": "Mock", "CompanyName": "AETERNUM Mock Shipping" },
  "Invoice": { "SellerName": "AETERNUM RECTUS LUCIS", "StorageDirectory": "App_Data/invoices" },
  "Notifications": {
    "UseMockProviders": true,
    "EmailDeliveryEnabled": true,
    "SmsDeliveryEnabled": false,
    "WorkerEnabled": true,
    "MaximumAttempts": 5,
    "BatchSize": 20,
    "PollIntervalSeconds": 5,
    "ProcessingLeaseSeconds": 300,
    "MaximumRetryDelayMinutes": 60
  },
  "FileStorage": {
    "RootDirectory": "App_Data/uploads",
    "MaximumFileBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Smtp": { "Port": 587, "UseSsl": true, "FromAddress": "noreply@example.invalid", "FromName": "AETERNUM RECTUS LUCIS", "TimeoutSeconds": 30 },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
