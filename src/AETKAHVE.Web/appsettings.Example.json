{
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=YOUR_SQL_SERVER;Database=AETKAHVE;User Id=YOUR_USER;Password=USE_A_SECRET_PROVIDER;Encrypt=True;TrustServerCertificate=False"
  },
  "Security": {
    "AdminIdleTimeoutMinutes": 15,
    "SuperAdminIdleTimeoutMinutes": 10,
    "CustomerRememberMeDays": 30,
    "AdminRememberMeHours": 12,
    "SuperAdminRememberMeHours": 4,
    "IdleWarningSeconds": 60,
    "AdminRoute": "admin",
    "SuperAdminRoute": "superadmin",
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "CustomerLoginRequestsPerMinute": 10,
    "AdminLoginRequestsPerMinute": 5,
    "SuperAdminLoginRequestsPerMinute": 5,
    "CustomerRegistrationRequestsPerMinute": 5,
    "PasswordRecoveryRequestsPerMinute": 5,
    "ContactRequestsPerMinute": 5,
    "CookieSecurePolicy": "Always",
    "CookieSameSiteMode": "Lax"
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "ForwardLimit": 1,
    "KnownProxies": [ "10.0.0.10" ],
    "KnownNetworks": []
  },
  "DataProtection": {
    "ApplicationName": "AETKAHVE",
    "KeyRingPath": "/var/lib/aetkahve/data-protection-keys",
    "CertificateThumbprint": "REPLACE_WITH_DEPLOYMENT_CERTIFICATE_THUMBPRINT"
  },
  "IdentitySeed": {
    "Enabled": false,
    "AdminEmail": "",
    "AdminPassword": "",
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  "Commerce": {
    "Currency": "TRY",
    "GuestCartLifetimeDays": 30,
    "MaximumCartItemQuantity": 20,
    "ShippingFee": 0,
    "FreeShippingThreshold": 0,
    "ReturnWindowDays": 14,
    "SeedDevelopmentData": false
  },
  "Payment": { "Provider": "Stripe" },
  "Stripe": {
    "SecretKey": "USE_A_SECRET_PROVIDER",
    "PublishableKey": "pk_live_or_pk_test_...",
    "WebhookSecret": "USE_A_SECRET_PROVIDER"
  },
  "Shipping": { "Provider": "ProductionAdapterRequired", "CompanyName": "YOUR_SHIPPING_COMPANY" },
  "Invoice": { "SellerName": "AETERNUM RECTUS LUCIS", "StorageDirectory": "App_Data/invoices" },
  "Notifications": {
    "UseMockProviders": false,
    "AllowExternalDeliveryInDevelopment": false,
    "EmailDeliveryEnabled": true,
    "SmsDeliveryEnabled": false,
    "WorkerEnabled": true,
    "MaximumAttempts": 5,
    "BatchSize": 20,
    "PollIntervalSeconds": 5,
    "ProcessingLeaseSeconds": 300,
    "MaximumRetryDelayMinutes": 60
  },
  "FileStorage": {
    "RootDirectory": "App_Data/uploads",
    "MaximumFileBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "UserName": "USE_A_SECRET_PROVIDER",
    "Password": "USE_A_SECRET_PROVIDER",
    "FromAddress": "noreply@example.com",
    "FromName": "AETERNUM RECTUS LUCIS",
    "TimeoutSeconds": 30
  }
}
