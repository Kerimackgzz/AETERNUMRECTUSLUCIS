{
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=YOUR_SQL_SERVER;Database=AETKAHVE;User Id=YOUR_USER;Password=USE_A_SECRET_PROVIDER;Encrypt=True;TrustServerCertificate=False"
  },
  "Security": {
    "AdminIdleTimeoutMinutes": 15,
    "SuperAdminIdleTimeoutMinutes": 10,
    "CustomerRememberMeDays": 30,
    "AdminRememberMeHours": 12,
    "SuperAdminRememberMeHours": 4,
    "IdleWarningSeconds": 60,
    "AdminRoute": "admin",
    "SuperAdminRoute": "superadmin",
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "CookieSecurePolicy": "Always",
    "CookieSameSiteMode": "Lax"
  },
  "IdentitySeed": {
    "Enabled": false,
    "AdminEmail": "",
    "AdminPassword": "",
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  "Commerce": {
    "Currency": "TRY",
    "GuestCartLifetimeDays": 30,
    "MaximumCartItemQuantity": 20,
    "ShippingFee": 0,
    "FreeShippingThreshold": 0,
    "ReturnWindowDays": 14,
    "SeedDevelopmentData": false
  },
  "Payment": { "Provider": "Mock" },
  "Shipping": { "Provider": "Mock", "CompanyName": "AETERNUM Mock Shipping" },
  "Invoice": { "SellerName": "AETERNUM RECTUS LUCIS", "StorageDirectory": "App_Data/invoices" },
  "Notifications": { "UseMockProviders": true, "MaximumAttempts": 5, "PollIntervalSeconds": 5, "ProcessingLeaseSeconds": 300 },
  "FileStorage": {
    "RootDirectory": "App_Data/uploads",
    "MaximumFileBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "UserName": "USE_A_SECRET_PROVIDER",
    "Password": "USE_A_SECRET_PROVIDER",
    "FromAddress": "noreply@example.com",
    "FromName": "AETERNUM RECTUS LUCIS"
  }
}
